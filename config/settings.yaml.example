# Application metadata
app:
  name: "Canon AI Trading"
  version: "0.1.0"
  symbol: "XAUUSD"
  broker: "XMGlobal"

# Market Data Engine configuration (Sprint 1)
market_data:
  symbol: "XAUUSD"
  broker: "XMGlobal"
  timeframes:
    - M1
    - M5
    - M15
    - M30
    - H1
    - H4
    - D1
  tick_enabled: true
  history_bars: 500
  stale_threshold_sec: 30

# Market Structure Engine configuration (Sprint 2)
market_structure:
  enabled: true
  timeframes:
    - M15
    - H1
    - H4
  swing_lookback: 5
  internal_swing_lookback: 2
  external_swing_lookback: 5
  min_confidence: 0.5
  min_candles: 10

# Engine toggles (future sprints)
engines:
  market_data: true
  market_structure: true
  smart_money: false
  liquidity: false
  trend: false
  price_action: false
  macro_events: false
  news: false
  volatility: false
  risk: false
  decision: false
  notification: false

# Logging
logging:
  level: "INFO"
