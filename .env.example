# Application
APP_NAME=Canon AI Trading
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_API_DOCS=false

# Database
DATABASE_URL=sqlite:///./data/canon_ai_trading.db

# Trading
TRADING_SYMBOL=XAUUSD
BROKER=XMGlobal

# MetaTrader 5 (XMGlobal) — do not commit real credentials
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Telegram Bot API — do not commit real tokens
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
